ostream& operator<<(ostream& os, const Trail& t) {
    os << "Trail {\n"
       << "  Name: " << t.name << "\n"
       << "  Distance: " << t.distance << "\n"
       << "  Has waterfall: " << (t.hasWaterfall ? "true" : "false") << "\n"
       << "}\n";
    return os;
}

